// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Reset event merge ID settings snapshots > round trips a saved event merge ID before the first validation 1`] = `
{
  "errors": [],
  "schemaTreeErrors": [],
  "settingsAfterValidate": {
    "eventMergeId": "%event.id%",
  },
  "settingsBeforeValidate": {
    "eventMergeId": "%event.id%",
  },
  "valid": true,
}
`;
