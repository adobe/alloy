{
  "name": "@adobe/alloy",
  "version": "2.38.0-beta.1",
  "description": "Adobe Experience Platform Web SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/alloy.git",
    "directory": "packages/browser"
  },
  "author": "Adobe Inc.",
  "license": "Apache-2.0",
  "bin": {
    "alloyBuilder": "scripts/alloyBuilder.js"
  },
  "files": [
    "src",
    "dist",
    "components.json",
    "scripts/alloyBuilder.js",
    "scripts/helpers/componentMetadata.js",
    "scripts/helpers/generateEntryPoint.js",
    "scripts/helpers/path.js",
    "rollup.config.js",
    "LICENSE_BANNER"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.serviceWorker.json && tsc -p test/typecheck/tsconfig.json",
    "clean": "rimraf dist distTest",
    "prepack": "pnpm run build",
    "release": "node scripts/release.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json && pnpm run build:baseCode && rollup -c --environment BASE_CODE_MIN,STANDALONE,STANDALONE_MIN,SERVICE_WORKER,SERVICE_WORKER_MIN,UTILITY_EXPORTS,BUNDLESIZE",
    "build:baseCode": "node scripts/copyBaseCode.mjs",
    "build:watch": "rollup -c --watch --environment BASE_CODE_MIN,STANDALONE,SERVICE_WORKER,UTILITY_EXPORTS",
    "dev:prepare": "rollup -c --environment BASE_CODE_MIN,STANDALONE,SERVICE_WORKER,UTILITY_EXPORTS",
    "dev": "pnpm run build:watch",
    "build:custom": "node --conditions=alloy-source --import ../../scripts/helpers/registerTsFromJsHook.js scripts/alloyBuilder.js"
  },
  "exports": {
    ".": {
      "alloy-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./baseCode.js": {
      "alloy-source": "./src/baseCode/index.js",
      "types": "./dist/baseCode/index.d.ts",
      "default": "./dist/baseCode/index.js"
    },
    "./standalone.js": {
      "alloy-source": "./src/standalone.ts",
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./serviceWorker.js": {
      "alloy-source": "./src/serviceWorker.ts",
      "types": "./dist/serviceWorker.d.ts",
      "default": "./dist/serviceWorker.js"
    },
    "./utils/deepAssign.js": {
      "alloy-source": "./src/utils/deepAssign.ts",
      "types": "./dist/utils/deepAssign.d.ts",
      "default": "./dist/utils/deepAssign.js"
    },
    "./libEs6/utils/deepAssign": {
      "alloy-source": "./src/utils/deepAssign.ts",
      "types": "./dist/utils/deepAssign.d.ts",
      "default": "./dist/utils/deepAssign.js"
    },
    "./utils/createEventMergeId.js": {
      "alloy-source": "./src/utils/createEventMergeId.ts",
      "types": "./dist/utils/createEventMergeId.d.ts",
      "default": "./dist/utils/createEventMergeId.js"
    },
    "./libEs6/components/EventMerge/createEventMergeId": {
      "alloy-source": "./src/utils/createEventMergeId.ts",
      "types": "./dist/utils/createEventMergeId.d.ts",
      "default": "./dist/utils/createEventMergeId.js"
    },
    "./components.json": "./components.json"
  },
  "dependencies": {
    "@adobe/alloy-core": "workspace:^",
    "@inquirer/prompts": "^7.9.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "commander": "^14.0.2",
    "js-cookie": "3.0.7",
    "oxc-transform": "^0.155.0",
    "rollup": "^4.60.3",
    "rollup-plugin-license": "^3.7.1"
  },
  "devDependencies": {
    "msw": "^2.14.3",
    "rimraf": "^6.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
