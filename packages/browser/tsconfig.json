{
  "extends": "../../jsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "module": "ESNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    // Unconverted JavaScript is type-checked once it is converted to TypeScript.
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@adobe/alloy-core": ["../core/src/index.ts"],
      "@adobe/alloy-core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "distTest",
    "src/input.js",
    "src/serviceWorker.ts"
  ]
}
