{
  "extends": "../../jsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // ES2020 cannot express the `with { type: "json" }` import attribute.
    "module": "ESNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    // Unconverted JavaScript is type-checked once it is converted to TypeScript.
    "checkJs": false,
    "declaration": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "distTest"]
}
