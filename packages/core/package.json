{
  "name": "@adobe/alloy-core",
  "version": "1.3.2-beta.0",
  "description": "Adobe Experience Platform Web SDK Core",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/alloy.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "alloy-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./components.json": "./components.json",
    "./utils": {
      "alloy-source": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/dom": {
      "alloy-source": "./src/utils/dom/index.ts",
      "types": "./dist/utils/dom/index.d.ts",
      "default": "./dist/utils/dom/index.js"
    },
    "./utils/request": {
      "alloy-source": "./src/utils/request/index.ts",
      "types": "./dist/utils/request/index.d.ts",
      "default": "./dist/utils/request/index.js"
    },
    "./utils/validation": {
      "alloy-source": "./src/utils/validation/index.ts",
      "types": "./dist/utils/validation/index.d.ts",
      "default": "./dist/utils/validation/index.js"
    },
    "./services": {
      "alloy-source": "./src/services/index.ts",
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./*.js": {
      "alloy-source": "./src/*.js",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "alloy-source": "./src/*",
      "types": "./dist/*.d.ts",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "src",
    "components.json"
  ],
  "author": "Adobe Inc.",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/typecheck/tsconfig.json"
  },
  "dependencies": {
    "@adobe/aep-rules-engine": "^3.1.3",
    "@adobe/reactor-query-string": "^2.0.0",
    "uuid": "^14.0.0"
  }
}
