{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020",
    // The ES2020 default (es2020.full) plus Error cause options.
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "ES2022.Error"
    ],
    "checkJs": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "distTest"]
}
